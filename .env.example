# ── Quote request email pipeline ─────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local` — it is gitignored. On Vercel, set these in Project Settings
# → Environment Variables instead.

# Resend API key — server-side only. Never expose it to the client.
# https://resend.com/api-keys
RESEND_API_KEY=

# Where quote notifications go (the team inbox).
QUOTE_EMAIL_TO=info@expressadvertising.ae

# Envelope sender — must be on a domain verified in Resend.
QUOTE_EMAIL_FROM=quotes@expressadvertising.ae

# Cloudflare Turnstile secret key — server-side only (verified in /api/quote).
# https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key — safe to expose; used by the widget on the
# public quote form (NEXT_PUBLIC_ prefix inlines it into the client bundle).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Newsletter subscription pipeline ─────────────────────────────────────
# Optional — newsletter emails fall back to QUOTE_EMAIL_FROM above.
# NEWSLETTER_EMAIL_FROM=newsletter@expressadvertising.ae

# Optional — Resend audience ID for real subscription-list management.
# When set, /api/newsletter also adds the subscriber as a contact.
# https://resend.com/audiences
# RESEND_AUDIENCE_ID=re_12345678
